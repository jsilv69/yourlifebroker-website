# Copy to .env for local dev:  cp .env.example .env
# In production these are set as Fly secrets, NOT committed.

# --- Required ---
MONDAY_TOKEN=your_monday_api_token_here
# YourLifeBroker "Leads" board (same board the Aircall->Monday service writes to)
MONDAY_BOARD_ID=18417923566

# --- Optional ---
MONDAY_GROUP_ID=
# Pin a Monday API version, e.g. 2024-10 (blank = account default)
MONDAY_API_VERSION=
# Only needed if the website is hosted on a DIFFERENT domain than this API
ALLOW_ORIGIN=
PORT=8080

# --- Column ID mapping ---
# Any COL_* left blank/unset is simply not written (no error). Only the columns
# you map get populated; everything is also captured in the Notes summary below.
#
# CONFIRMED on the YLB Leads board (verified live 2026-07-02):
COL_PHONE=lead_phone
COL_EMAIL=lead_email
COL_STATUS=lead_status
MONDAY_STATUS_LABEL=New Lead
# "Lead Source" text column — set to the per-page form name the visitor submitted
# (e.g. "Mortgage Protection Form"); falls back to LEAD_SOURCE if the form sends none.
COL_SOURCE=text_mm4f2gw1
LEAD_SOURCE=Website Quote Form
# Lead Source Group (status column, COL_SOURCE_GROUP) labels for web-form leads:
# "Google Ads" when the click carried a Google click ID or utm_source=google, else "Website".
# Labels auto-create on the board (create_labels_if_missing) if they don't exist yet.
WEB_SOURCE_GROUP_GOOGLE=Google Ads
WEB_SOURCE_GROUP_DEFAULT=Website
# Long-text column — receives a full summary of every answer (coverage, state, age,
# gender, nicotine, email, phone) plus marketing params. Captures fields without a column:
COL_NOTES=long_text_mm4k9vaw

# Marketing attribution → dedicated text columns (verified live 2026-07-05):
COL_CLID=text_mm4zffvh          # Google click id (gclid / gbraid / wbraid)
COL_UTM_SOURCE=text_mm4zra0p
COL_UTM_CAMPAIGN=text_mm4z6mpz
COL_UTM_ADGROUP=text_mm4zses3   # from utm_adgroup, falls back to utm_content
COL_UTM_KEYWORD=text_mm4z96zg   # from utm_term

# OPTIONAL — only if you create dedicated columns for these web-only fields.
# Run the columns query in the README to get each ID, then fill in. Blank = skip.
COL_STATE=
COL_COVERAGE=
COL_AGE=
COL_GENDER=
COL_NICOTINE=

# --- Meta Lead Ads (Instant Forms) webhook: /webhooks/meta ---
# META_VERIFY_TOKEN is needed for the webhook verification handshake (set it here
# AND paste the same value into the Meta webhook config). APP_SECRET + PAGE_TOKEN
# are needed to receive/fetch real leads.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=            # System User / Page token with leads_retrieval
META_GRAPH_VERSION=v21.0
META_LEAD_SOURCE=Meta Instant Form   # fallback Lead Source when a lead has no campaign (organic)
META_SOURCE_GROUP=Meta Ads           # Lead Source Group status label for Meta leads
COL_SOURCE_GROUP=color_mkyb8krc      # "Lead Source Group" status column
# Meta field mapping:
#   Lead Source (text)  = campaign name (falls back to META_LEAD_SOURCE)
#   Lead Source Group   = "Meta Ads" (status)
#   UTM Source = "meta", UTM Campaign = campaign, UTM Ad Group = ad set, UTM Keyword = ad name
#   all answers + IDs also go to Notes.
